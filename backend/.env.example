PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/momentum_tasks

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars_recommended
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars_recommended
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# For local development this should be: http://localhost:5000/api/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/github/callback

# GitHub repository access (create/connect a journal repo + sync solved
# problems) reuses the SAME OAuth app and callback URL above — no second
# callback URL or app to register. See GET /api/auth/github/connect-url.
# Optional: dedicated key for encrypting stored GitHub tokens at rest. Falls back
# to a key derived from JWT_SECRET if unset (fine for local dev; set a real one
# in production).
GITHUB_TOKEN_ENCRYPTION_KEY=

# Frontend URLs (for CORS & redirects)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Extension (optional)
EXTENSION_ID=your_chrome_extension_id

# Bcrypt (Password hashing)
BCRYPT_ROUNDS=10

# Momentum AI assistant (Groq — OpenAI-compatible chat completions API)
# Get a free key at https://console.groq.com/keys. The assistant page stays in
# a graceful "not configured" state until this is set.
GROQ_API_KEY=your_groq_api_key
# Optional — defaults to llama-3.3-70b-versatile. Any Groq chat model works.
GROQ_MODEL=llama-3.3-70b-versatile

# Email reminders (Gmail SMTP via Nodemailer). The reminder scheduler stays
# inert (no email sent, no error) until GMAIL_USER + GMAIL_APP_PASSWORD are
# both set. GMAIL_APP_PASSWORD is NOT your regular Gmail password — enable
# 2-Step Verification on the account, then generate one at
# https://myaccount.google.com/apppasswords. Delivers to any recipient with
# no domain verification needed, subject to Gmail's own sending limits
# (~500/day on a regular account).
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
MAIL_FROM_NAME=Momentum

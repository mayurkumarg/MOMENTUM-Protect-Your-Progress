{
  "manifest_version": 3,
  "name": "Momentum - Task Manager",
  "version": "1.0.0",
  "description": "Task management extension with GitHub OAuth",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Momentum"
  }
}
